#include <stdio.h>

int main()
{
    int price[] = {200, 500, 300};
    int qty[] = {2, 3, 4};
    int senior[] = {1, 0, 1};

    for(int i = 0; i < 3; i++)
    {
        double gross = (double)price[i] * qty[i];
        double discount = senior[i] ? gross * 0.15 : 0;
        double gst = (gross - discount) * 0.05;
        double total = gross - discount + gst;
        double net = total > 1000 ? total - 50 : total;

        printf("\nBill %d\n", i + 1);
        printf("Gross = %.2f\n", gross);
        printf("Discount = %.2f\n", discount);
        printf("GST = %.2f\n", gst);
        printf("Total = %.2f\n", total);
        printf("Net = %.2f\n", net);
    }

    return 0;
}
